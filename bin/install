#!/usr/bin/env -S ciel --
;;;; Same-host installation from a Git checkout; no network operations.
(let* ((args (uiop:command-line-arguments))
       (args (if (equal (first args) "--") (rest args) args))
       (root (truename (merge-pathnames "../" (uiop:pathname-directory-pathname (truename (first args))))))
       (options (rest args))
       (home (user-homedir-pathname))
       (config (merge-pathnames "twigwm/"
                 (uiop:ensure-directory-pathname
                   (or (uiop:getenv "XDG_CONFIG_HOME") (merge-pathnames ".config/" home)))))
       (contents (merge-pathnames "Applications/TwigWM.app/Contents/" home)))
  (labels ((xml (text)
             "TEXT, a string or pathname, escaped for an XML property list."
             (with-output-to-string (s)
               (loop for c across (namestring text) do
                 (write-string (case c (#\& "&amp;") (#\< "&lt;")
                                     (#\> "&gt;") (t (string c))) s))))
           (run (&rest command)
             "Run COMMAND, showing its output, and signal an error if it fails."
             (uiop:run-program command :output :interactive :error-output :interactive))
           (build-app (identity)
             "Build ~/Applications/TwigWM.app in Ciel.app's layout and sign it with
IDENTITY: this Ciel's SBCL runtime as the executable, an image saved with
TwigWM loaded beside it, as a runtime with its core appended cannot be signed,
and the SBCL contribs. macOS keys Accessibility and Input Monitoring grants to
the signing identity and bundle identifier, so a stable IDENTITY keeps them
across rebuilds, where the ad-hoc \"-\" loses them."
             (let ((runtime sb-ext:*runtime-pathname*)
                   (core (merge-pathnames "Resources/twigwm.core" contents)))
               (uiop:delete-directory-tree (merge-pathnames "../" contents)
                                           :validate t :if-does-not-exist :ignore)
               (ensure-directories-exist (merge-pathnames "MacOS/" contents))
               (ensure-directories-exist core)
               (uiop:copy-file runtime (merge-pathnames "MacOS/twigwm" contents))
               (run "chmod" "755" (namestring (merge-pathnames "MacOS/twigwm" contents)))
               (run "cp" "-R" (namestring (truename (merge-pathnames "lib/" (uiop:pathname-directory-pathname runtime))))
                    (namestring (merge-pathnames "Resources/lib" contents)))
               (run "ln" "-s" "../Resources/lib" (namestring (merge-pathnames "MacOS/lib" contents)))
               (with-open-file (s (merge-pathnames "Info.plist" contents) :direction :output)
                 (format s "<?xml version=~s encoding=~s?>~%<plist version=~s><dict>~%" "1.0" "UTF-8" "1.0")
                 (format s "<key>CFBundleExecutable</key><string>twigwm</string>~%")
                 (format s "<key>CFBundleIdentifier</key><string>org.twigwm.TwigWM</string>~%")
                 (format s "<key>CFBundleName</key><string>TwigWM</string>~%")
                 (format s "<key>CFBundleShortVersionString</key><string>~a</string>~%"
                         (xml (string-trim '(#\Space #\Newline) (uiop:read-file-string (merge-pathnames "VERSION" root)))))
                 (format s "<key>CFBundlePackageType</key><string>APPL</string>~%")
                 (format s "<key>LSUIElement</key><true/>~%</dict></plist>~%"))
               (run (namestring runtime) "--core" (namestring sb-ext:*core-pathname*) "--noinform"
                    "--end-runtime-options" "--no-userinit" "-e"
                    (with-standard-io-syntax
                      (prin1-to-string
                       `(progn
                          (load ,(namestring (merge-pathnames "src/load.lisp" root)))
                          (setf uiop:*image-entry-point* (lambda () (funcall (find-symbol "COMMAND-LINE" "TWIGWM")))
                                uiop/image::*image-restored-p* nil)
                          (sb-ext:save-lisp-and-die ,(namestring core) :toplevel #'uiop:restore-image)))))
               (run "codesign" "--force" "--sign" identity (namestring (merge-pathnames "../" contents)))
               (run "codesign" "--verify" "--strict" (namestring (merge-pathnames "../" contents))))))
    (handler-case
        (progn
          (dolist (pair (list (cons (merge-pathnames "bin/twigwm" root)
                                   (merge-pathnames ".local/bin/twigwm" home))
                             (cons root (merge-pathnames "source" config))))
            (ensure-directories-exist (cdr pair))
            (uiop:run-program (list "ln" "-sfn" (namestring (car pair)) (namestring (cdr pair)))))
          (when (or (member "--app" options :test #'equal) (member "--mac-input" options :test #'equal))
            (unless (uiop:os-macosx-p) (error "--app and --mac-input require macOS"))
            (build-app (or (second (member "--sign" options :test #'equal)) "-")))
          (when (member "--mac-input" options :test #'equal)
            (let* ((uid (string-trim '(#\Space #\Newline) (uiop:run-program '("id" "-u") :output :string)))
                   (domain (concatenate 'string "gui/" uid))
                   (plist (merge-pathnames "Library/LaunchAgents/org.twigwm.input.plist" home))
                   (log (merge-pathnames "Library/Logs/twigwm-input.log" home)))
              (ensure-directories-exist plist)
              (ensure-directories-exist log)
              (with-open-file (s plist :direction :output :if-exists :supersede)
                (format s "<?xml version=~s encoding=~s?>~%<plist version=~s><dict>~%" "1.0" "UTF-8" "1.0")
                (format s "<key>Label</key><string>org.twigwm.input</string>~%")
                (format s "<key>ProgramArguments</key><array>~{<string>~a</string>~}</array>~%"
                        (mapcar #'xml (list (merge-pathnames "MacOS/twigwm" contents)
                                            "--core" (merge-pathnames "Resources/twigwm.core" contents)
                                            "--noinform" "--end-runtime-options" "mac-input")))
                (format s "<key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>10</integer>~%")
                (format s "<key>LimitLoadToSessionType</key><string>Aqua</string><key>ProcessType</key><string>Interactive</string>~%")
                (format s "<key>StandardOutPath</key><string>~a</string><key>StandardErrorPath</key><string>~a</string>~%</dict></plist>~%" (xml log) (xml log)))
              (uiop:run-program (list "launchctl" "bootout" (concatenate 'string domain "/org.twigwm.input"))
                                :ignore-error-status t :error-output nil)
              (uiop:run-program (list "launchctl" "bootstrap" domain (namestring plist)))))
          (format t "TwigWM installed from ~a~%" root))
      (error (e) (format *error-output* "TwigWM installation failed: ~a~%" e) (uiop:quit 1)))))
